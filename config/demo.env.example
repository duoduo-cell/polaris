# 另存为仓库根目录 .env.demo，由使用者填写；不覆盖个人 .env。
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://polaris:replace-demo-db-password@127.0.0.1:55432/polaris_demo
DEMO_DB_PASSWORD=replace-demo-db-password
OWNER_TOKEN=replace-with-separate-demo-owner-token
POLARIS_API=http://127.0.0.1:8010
# 从使用者自己的模型服务获取配置；运行对话仍需联网和支付模型用量。
LLM_BASE_URL=https://replace-with-your-provider.example/v1
LLM_API_KEY=replace-with-your-model-key
LLM_MODEL=replace-with-supported-model
LLM_MAX_RETRIES=0
LLM_TIMEOUT=45
LLM_MODEL_CHAT=
LLM_MODEL_EXTRACT=
LLM_MODEL_JUDGE=
LLM_MODEL_BRIEF=
NEO4J_PASSWORD=
INGEST_TOKEN=
MCP_TOKEN=
RERANK_BASE_URL=
