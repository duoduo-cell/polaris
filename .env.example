# 复制成 .env 后填入真实值。.env 不进仓库。

# 对话模型：任何 OpenAI 兼容的服务，地址带不带 /v1 都行
LLM_BASE_URL=https://example.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-v4.1-flash
# 按角色单独指定模型（可选，不配就用 LLM_MODEL）
# LLM_MODEL_CHAT=
# LLM_MODEL_EXTRACT=
# LLM_MODEL_JUDGE=
# LLM_MODEL_BRIEF=
# 结构化输出：auto 先试 json_schema；已知服务不支持时写 json_object
LLM_JSON_MODE=auto
# 评测反复跑时打开，同样的请求直接读上次的回答
# LLM_CACHE=true
# LLM_CONCURRENCY=4

# 向量服务，和对话分开配。开发期用阿里云百炼（OpenAI 兼容）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-xxxx
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# Polaris 自己的入库口令：本机采集器往 /api/ingest/raw-items 推数据时用。随便生成一串随机字符
INGEST_TOKEN=change-me
# MCP 口令：Hermes、Claude 等 MCP 客户端连 /mcp/ 时用。不配就关闭 MCP
MCP_TOKEN=change-me

# 可选：开发期把 LangGraph 的每一步同步到 LangSmith（需要 LangSmith 账号）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# 数据库（可选，默认连 docker compose 起的那个）
# DATABASE_URL=postgresql+psycopg://polaris:polaris@127.0.0.1:5432/polaris

# 提交前换成 Nebius Token Factory：
# LLM_BASE_URL=https://api.tokenfactory.nebius.com
# LLM_API_KEY=你的 Nebius key
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_MODEL_EXTRACT=nvidia/Nemotron-3_5-Lightning
# LLM_MODEL_BRIEF=nvidia/Nemotron-3-Ultra-550b-a55b
# EMBED_BASE_URL=https://api.tokenfactory.nebius.com/v1
# EMBED_API_KEY=你的 Nebius key
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
