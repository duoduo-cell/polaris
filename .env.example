# 复制成 .env 后填入真实值。.env 不进仓库。

# 开发期：任何 OpenAI 兼容的服务
LLM_BASE_URL=https://example.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-5.5
LLM_EMBED_MODEL=text-embedding-3-small

# 向量服务，和对话分开配。开发期用阿里云百炼（OpenAI 兼容）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-xxxx
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# 提交前换成 Nebius Token Factory：
# LLM_BASE_URL=https://api.tokenfactory.nebius.com
# LLM_API_KEY=你的 Nebius key
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# EMBED_BASE_URL=https://api.tokenfactory.nebius.com/v1
# EMBED_API_KEY=你的 Nebius key
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
